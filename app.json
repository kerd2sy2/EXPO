{
  "expo": {
    "name": "أبرار | عهدة",
    "slug": "ahda",
    "owner": "1eff2027ef",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aams-ahda",
    "userInterfaceStyle": "automatic",
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json",
      "ur": "./locales/ur.json",
      "bn": "./locales/bn.json"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.aams.ahda",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.aams.ahda",
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 13,
      "intentFilters": [
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "image/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [
            {
              "mimeType": "image/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-share-intent",
      [
        "expo-camera",
        {
          "cameraPermission": "السماح لتطبيق AAMS العهدة باستخدام الكاميرا لتصوير وتوثيق فواتير وسندات المصاريف."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "السماح بالوصول لمعرض الصور لاختيار صور الفواتير وتوثيق العهدة."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-updates",
        {
          "username": "1eff2027ef"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/cdadebab-754b-453e-9937-68839d0b9982",
      "enabled": true,
      "fallbackToCacheTimeout": 2000,
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cdadebab-754b-453e-9937-68839d0b9982"
      },
      "appNames": {
        "ar": "أبرار | عهدة",
        "en": "AAMS | Custody",
        "ur": "ابرار | تحویل",
        "bn": "আবরার | হেফাজত"
      }
    }
  }
}
