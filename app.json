{
  "expo": {
    "name": "أبرار | إشراف",
    "slug": "aams-eshraf",
    "owner": "4e4773f0c1",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aams-eshraf",
    "userInterfaceStyle": "automatic",
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json",
      "ur": "./locales/ur.json",
      "bn": "./locales/bn.json"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.aams.eshraf",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.aams.eshraf",
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_NOTIFICATION_POLICY",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 12
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "السماح لتطبيق AAMS باستخدام الكاميرا لمسح لوحات الدبابات وعدادات المسافات بالذكاء الاصطناعي."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "السماح بالوصول لمعرض الصور لتحميل وتوثيق صور العمل."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "السماح بالوصول للموقع لإرسال الإحداثيات الدقيقة في حالات الطوارئ وبلاغات الحوادث."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-updates",
        {
          "username": "1eff2027ef"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0284c7",
          "defaultChannel": "aams_broadcasts",
          "sounds": []
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.microsoft.clarity.** { *; }\n-dontwarn com.microsoft.clarity.**\n-keep class com.mixpanel.android.** { *; }\n-keepattributes *Annotation*\n-keep interface com.mixpanel.android.** { *; }\n-dontwarn com.mixpanel.android.**\n-keep class com.google.mlkit.** { *; }\n-dontwarn com.google.mlkit.**\n-keep class com.facebook.react.** { *; }\n-dontwarn com.facebook.react.**"
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6a773c7d-b3bb-4930-be5b-f451d6868bcd",
      "enabled": true,
      "fallbackToCacheTimeout": 2000,
      "checkAutomatically": "ON_LOAD"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "appNames": {
        "ar": "أبرار | إشراف",
        "en": "AAMS | Supervision",
        "ur": "ابرار | نگرانی",
        "bn": "আবরার | তত্ত্বাবধান"
      },
      "eas": {
        "projectId": "6a773c7d-b3bb-4930-be5b-f451d6868bcd"
      }
    }
  }
}