{
  "expo": {
    "name": "AAMS",
    "slug": "aams",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aams",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.aams.app"
    },
    "android": {
      "package": "com.aams.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "يسمح هذا الإذن بتتبع الكيلومترات المقطوعة أثناء الشفت تلقائياً حتى عندما يكون التطبيق في الخلفية.",
          "locationAlwaysPermission": "يسمح هذا الإذن بتتبع الكيلومترات المقطوعة أثناء الشفت تلقائياً.",
          "locationWhenInUsePermission": "يسمح هذا الإذن بتتبع الكيلومترات المقطوعة أثناء الشفت.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-updates",
        {
          "username": "aamsmailnaco"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/352e8773-7aaa-4a12-b906-01fe05420113",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "eas": {
        "projectId": "352e8773-7aaa-4a12-b906-01fe05420113"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
