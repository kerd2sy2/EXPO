{
  "expo": {
    "name": "AHDA",
    "slug": "aams",
    "owner": "aams2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aams-ahda",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.aams.ahda"
    },
    "android": {
      "package": "com.aams.ahda",
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 9
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "السماح لتطبيق AAMS العهدة باستخدام الكاميرا لتصوير وتوثيق فواتير وسندات المصاريف."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "السماح بالوصول لمعرض الصور لاختيار صور الفواتير وتوثيق العهدة."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-updates",
        {
          "username": "aams2"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/1ec8ea7a-75d2-43be-b7cf-5505a283c042",
      "enabled": true,
      "fallbackToCacheTimeout": 2000,
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ec8ea7a-75d2-43be-b7cf-5505a283c042"
      }
    }
  }
}
