{
  "expo": {
    "name": "عهدة",
    "slug": "ahda",
    "owner": "4e4773f0c1",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aams-ahda",
    "userInterfaceStyle": "automatic",
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json",
      "ur": "./locales/ur.json",
      "bn": "./locales/bn.json"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.aams.ahda",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.aams.ahda",
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#00fa91",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 16,
      "intentFilters": [
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "image/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [
            {
              "mimeType": "image/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-share-intent",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "CustodyWidget",
              "displayName": "عهدة - الرصيد اليومي",
              "description": "عرض صافي رصيد العهدة والمصروفات اليومية لجميع الفروع",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              },
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2
              }
            }
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "السماح لتطبيق AAMS العهدة باستخدام الكاميرا لتصوير وتوثيق فواتير وسندات المصاريف."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "السماح بالوصول لمعرض الصور لاختيار صور الفواتير وتوثيق العهدة."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-updates",
        {
          "username": "4e4773f0c1"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/bd05cce0-4566-4c1e-a09b-cef372ced967",
      "enabled": true,
      "fallbackToCacheTimeout": 2000,
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd05cce0-4566-4c1e-a09b-cef372ced967"
      },
      "appNames": {
        "ar": "عهدة",
        "en": "AAMS | Custody",
        "ur": "ابرار | تحویل",
        "bn": "আবরার | হেফাজত"
      }
    }
  }
}
